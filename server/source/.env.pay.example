# ============================================================
# 聚合支付配置示例（易支付 / 码支付 / PayJS 等兼容平台）
# 复制本文件为 .env（或在系统环境变量中设置），重启 relay_rs 生效。
# ============================================================

# 支付网关下单接口地址（平台后台通常叫"接口地址"或"提交地址"）
#   彩虹易支付 : https://pay.example.com/submit.php
#   PayJS      : https://pay.example.com/submit.php
PAY_GATEWAY=https://pay.example.com/submit.php

# 商户号（PID）
PAY_PID=1000

# 商户密钥（KEY，用于 MD5 签名，与平台后台一致）
PAY_KEY=your_pay_key_here

# 异步通知地址：必须是公网可访问的完整 URL，平台支付成功后回调这里。
# 对应本服务的 /api/card/pay_callback/ 路由（GET/POST 均支持）。
PAY_NOTIFY_URL=https://your-domain.com/api/card/pay_callback/

# 同步跳转地址：用户在收银台支付完成后浏览器跳转的页面。
PAY_RETURN_URL=https://your-domain.com/card/

# 商品名称（显示在支付平台的订单标题中）
PAY_PRODUCT_NAME=OMMEGA 年卡

# 兼容旧的 CARD_CALLBACK_SECRET 回调方式（可留空）
CARD_CALLBACK_SECRET=
