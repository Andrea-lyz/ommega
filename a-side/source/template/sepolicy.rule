allow keystore system_file unix_dgram_socket { getattr read recvfrom }
allow system_file keystore unix_dgram_socket sendto
allow keystore system_file file { execute getattr map read receive }

allow crash_dump keystore process *

allow keystore default_android_service service_manager find
allow shell default_android_service service_manager find

# The exact EngineerMode caller binding reads argv[0] from /proc/<binder-pid>.
# Keep this limited to its application domain; core system domains stay blocked.
allow keystore engineermode_app dir search
allow keystore engineermode_app file { getattr open read }

# Bind an explicit isolated grantee to its live /proc process instance.
allow keystore isolated_app dir { getattr search }
allow keystore isolated_app file { getattr open read }
allow keystore proc_random file { getattr open read }
