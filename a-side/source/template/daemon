#!/system/bin/sh

MODDIR=${0%/*}
STATE_DIR=/data/adb/ommega
RPC_SOCKET=/data/misc/keystore/ommega/rpc.sock
RESTART_FILE=$STATE_DIR/restart.keymint
PEER_RESTART_FILE=$STATE_DIR/restart.injector
RESTART_ALL_FILE=$STATE_DIR/restart.all

export LD_LIBRARY_PATH="$LD_LIBRARY_PATH:/vendor/lib64/:/system/lib64/:/apex/com.android.runtime/lib64/bionic/"

find_module_keymint() {
  if [ -f "/data/adb/ommega/keymint" ]; then
    echo /data/adb/ommega/keymint
    return 0
  fi
  if [ -f "$MODDIR/keymint" ]; then
    echo "$MODDIR/keymint"
    return 0
  fi
  if [ -f "$MODDIR/libs/arm64-v8a/keymint" ]; then
    echo "$MODDIR/libs/arm64-v8a/keymint"
    return 0
  fi
  if [ -f "$MODDIR/libs/x86_64/keymint" ]; then
    echo "$MODDIR/libs/x86_64/keymint"
    return 0
  fi
  return 1
}

expand_shared_restart() {
  if [ -f "$RESTART_ALL_FILE" ]; then
    : > "$RESTART_FILE"
    : > "$PEER_RESTART_FILE"
    rm -f "$RESTART_ALL_FILE"
  fi
}

consume_restart_request() {
  expand_shared_restart

  if [ -f "$RESTART_FILE" ]; then
    rm -f "$RESTART_FILE"
    return 0
  fi

  return 1
}

cd "$MODDIR" || exit 1
mkdir -p "$STATE_DIR"

while true; do
  TARGET=$(find_module_keymint)
  if [ -z "$TARGET" ]; then
    echo "[keymint-daemon] keymint binary not found"
    sleep 5
    continue
  fi

  chmod 0755 "$TARGET"

  # Clear a stale keymint instance (exact binary path) before starting a
  # fresh one, so a leftover child from a previous daemon run can never
  # coexist with the new instance. No other module process is matched.
  pkill -9 -f "$TARGET" 2>/dev/null
  sleep 1
  # Unix socket inodes survive an unclean process exit and a device reboot.
  # Remove the previous instance before starting keymint so the injector's
  # socket readiness check cannot accept a stale, non-listening endpoint.
  rm -f "$RPC_SOCKET"

  "$TARGET" "$@" &
  child_pid=$!

  while kill -0 "$child_pid" 2>/dev/null; do
    if consume_restart_request; then
      echo "[keymint-daemon] restart requested"
      kill -TERM "$child_pid" 2>/dev/null
      sleep 2
      if kill -0 "$child_pid" 2>/dev/null; then
        kill -KILL "$child_pid" 2>/dev/null
      fi
      break
    fi
    sleep 2
  done

  wait "$child_pid"
  rc=$?
  echo "[keymint-daemon] keymint exited with code $rc"
  sleep 2
done
